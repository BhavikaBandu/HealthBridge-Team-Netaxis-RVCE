# Local development settings. Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://healthcare:healthcare@localhost:5432/healthcare
APP_TITLE=Healthcare Knowledge Explorer
# Optional overrides
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# SNAPSHOT_DIR=data/processed/snapshots

# Patient portal
# Private folder for uploaded documents (never inside frontend/static)
UPLOAD_DIR=data/private_uploads
MAX_UPLOAD_MB=10
# Set to true when served over HTTPS so session cookies are Secure-only
COOKIE_SECURE=false
SESSION_HOURS=12

# Phase 3 AI agents (wording only; matches, conversions of record and flags are decided by code / validated)
# ollama = local open-source model (install Ollama, then: ollama pull qwen3:30b-a3b)
# mock = template wording, no AI
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:30b-a3b
# OLLAMA_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=300
